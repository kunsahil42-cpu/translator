<UserControl x:Class="GamingLiveTranslator.Views.TranslatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GamingLiveTranslator.ViewModels"
             xmlns:speech="clr-namespace:GamingLiveTranslator.Services.Speech"
             Padding="28"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TranslatorViewModel}"
             d:DesignHeight="850" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Live Translation Session" Style="{StaticResource TextHeader1}" />
            <TextBlock Text="Real-time speech recognition (Deepgram Nova-2) with Google Cloud Translation."
                       Style="{StaticResource TextSubtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Card 1: Microphone & Language Pairing Controls -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Microphone Input + Start/Stop Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MICROPHONE INPUT" Style="{StaticResource TextCardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox ItemsSource="{Binding AvailableDevices}"
                                      SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="Name"
                                      Width="340"
                                      Background="{StaticResource CardElevatedBackgroundBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      Padding="8,6"
                                      FontSize="13" />

                            <Button Content="↻"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    ToolTip="Refresh audio devices"
                                    Margin="8,0,0,0"
                                    Padding="10,6" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions: Start / Stop -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▶  Start Session"
                                Command="{Binding StartCaptureCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Margin="0,0,8,0"
                                Padding="20,8" />

                        <Button Content="⏹  Stop"
                                Command="{Binding StopCaptureCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Padding="18,8" />
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}" Margin="0,0,0,-8" />

                <!-- Row 1: Language Direction Selector -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="TRANSLATE:" 
                               Style="{StaticResource TextCardTitle}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,12,0" />

                    <!-- Source Language -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableSourceLanguages}"
                              SelectedItem="{Binding SelectedSourceLanguage}"
                              DisplayMemberPath="DisplayName"
                              Background="{StaticResource CardElevatedBackgroundBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Padding="8,6"
                              FontSize="13" />

                    <!-- Swap Button -->
                    <Button Grid.Column="2"
                            Content="⇄"
                            Command="{Binding SwapLanguagesCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            ToolTip="Swap source and target languages"
                            Margin="8,0,8,0"
                            Padding="10,4"
                            FontSize="14"
                            FontWeight="Bold" />

                    <!-- Target Language -->
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding AvailableTargetLanguages}"
                              SelectedItem="{Binding SelectedTargetLanguage}"
                              DisplayMemberPath="DisplayName"
                              Background="{StaticResource CardElevatedBackgroundBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Padding="8,6"
                              FontSize="13" />

                    <!-- Hint / Direction -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="4" Padding="8,4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <TextBlock Text="{Binding SelectedSourceLanguage.Code, StringFormat={}{0} → }"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
                                <Run Text="{Binding SelectedTargetLanguage.Code}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Card 2: Live Speech Stream & Interim Preview -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock Text="LIVE SPEECH STREAM" Style="{StaticResource TextCardTitle}" DockPanel.Dock="Left" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Connection Status Dot -->
                        <Ellipse VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeepgramState}" Value="{x:Static speech:ConnectionState.Connected}">
                                            <Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DeepgramState}" Value="{x:Static speech:ConnectionState.Connecting}">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DeepgramState}" Value="{x:Static speech:ConnectionState.Reconnecting}">
                                            <Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DeepgramState}" Value="{x:Static speech:ConnectionState.Failed}">
                                            <Setter Property="Fill" Value="{StaticResource StatusDisconnectedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding DeepgramStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />

                        <!-- Audio Level Percentage -->
                        <TextBlock Text="Mic Level: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentLevel, StringFormat={}{0:P0}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- 10-Segment Discrete LED VU Meter -->
                <Border Background="{StaticResource CardElevatedBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12">
                    <UniformGrid Columns="10" HorizontalAlignment="Stretch">
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="1"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="2"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="3"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="4"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="5"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="6"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="7"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="2"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="3"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="4"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="5"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="6"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="7"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="3"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="4"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="5"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="6"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="7"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="4"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="5"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="6"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="7"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="5"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="6"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="7"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="6"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="7"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusConnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="7"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="8"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="9"><Setter Property="Fill" Value="{StaticResource StatusDisconnectedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusDisconnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource CardHoverBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelSegments}" Value="10"><Setter Property="Fill" Value="{StaticResource StatusDisconnectedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </UniformGrid>
                </Border>

                <!-- In-Progress Interim Preview Box -->
                <Border Background="{StaticResource CardElevatedBackgroundBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        MinHeight="56">
                    <TextBlock Text="{Binding InterimText}"
                               FontSize="14"
                               FontStyle="Italic"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InterimText}" Value="">
                                        <Setter Property="Text" Value="Listening for speech... (Start speaking into your microphone)" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Card 3: Dual-Column Live Translation History -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header + Clear Button -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock Text="TRANSLATION HISTORY" Style="{StaticResource TextCardTitle}" DockPanel.Dock="Left" VerticalAlignment="Center" />

                    <Button DockPanel.Dock="Right"
                            Content="Clear"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="12,4"
                            FontSize="11" />
                </DockPanel>

                <!-- Column Headers (Side-by-Side: Original vs Translated) -->
                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="ORIGINAL TRANSCRIPT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="TRANSLATED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                </Grid>

                <!-- Scrollable Dual-Column Feed -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TranscriptHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardElevatedBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat=[{0:HH:mm:ss}]}"
                                                   FontFamily="Consolas, monospace"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,2,0,0" />

                                        <!-- Original Spoken Text (Left Column) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding OriginalText}"
                                                       FontSize="14"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Text="{Binding SourceLanguage, StringFormat=Lang: {0}}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Divider Column -->
                                        <Rectangle Grid.Column="2" 
                                                   Width="1" 
                                                   Fill="{StaticResource BorderBrush}" 
                                                   HorizontalAlignment="Center" 
                                                   Margin="0,2" />

                                        <!-- Translated Text (Right Column) -->
                                        <Grid Grid.Column="3" VerticalAlignment="Top">
                                            <!-- Normal Translated State -->
                                            <StackPanel>
                                                <TextBlock Text="{Binding TranslatedText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTranslationFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusDisconnectedBrush}" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding TargetLanguage, StringFormat=Target: {0}}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer: Status Message -->
        <Border Grid.Row="4" Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="System: " FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
