<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Surface Colors -->
    <Color x:Key="WindowBackgroundColor">#0B0E14</Color>
    <Color x:Key="SidebarBackgroundColor">#10141D</Color>
    <Color x:Key="CardBackgroundColor">#161B26</Color>
    <Color x:Key="CardElevatedBackgroundColor">#1D2331</Color>
    <Color x:Key="CardHoverBackgroundColor">#222A3B</Color>

    <!-- Border & Divider Colors -->
    <Color x:Key="BorderColor">#262F42</Color>
    <Color x:Key="BorderLightColor">#36415D</Color>

    <!-- Accent & Glow Colors -->
    <Color x:Key="AccentColor">#00E5FF</Color>
    <Color x:Key="AccentHoverColor">#38EFFF</Color>
    <Color x:Key="AccentGlowColor">#3300E5FF</Color>
    
    <Color x:Key="PrimaryBrandColor">#6366F1</Color>
    <Color x:Key="PrimaryBrandHoverColor">#818CF8</Color>

    <!-- Status Colors -->
    <Color x:Key="StatusConnectedColor">#10B981</Color>
    <Color x:Key="StatusConnectedGlowColor">#3310B981</Color>
    <Color x:Key="StatusDisconnectedColor">#EF4444</Color>
    <Color x:Key="StatusDisconnectedGlowColor">#33EF4444</Color>
    <Color x:Key="StatusWarningColor">#F59E0B</Color>

    <!-- Typography Colors -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardElevatedBackgroundBrush" Color="{StaticResource CardElevatedBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource CardHoverBackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}" />

    <SolidColorBrush x:Key="PrimaryBrandBrush" Color="{StaticResource PrimaryBrandColor}" />
    <SolidColorBrush x:Key="PrimaryBrandHoverBrush" Color="{StaticResource PrimaryBrandHoverColor}" />

    <SolidColorBrush x:Key="StatusConnectedBrush" Color="{StaticResource StatusConnectedColor}" />
    <SolidColorBrush x:Key="StatusConnectedGlowBrush" Color="{StaticResource StatusConnectedGlowColor}" />
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="{StaticResource StatusDisconnectedColor}" />
    <SolidColorBrush x:Key="StatusDisconnectedGlowBrush" Color="{StaticResource StatusDisconnectedGlowColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

</ResourceDictionary>
